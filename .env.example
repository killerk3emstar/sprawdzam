# Copy to .env and fill in. Never commit .env.

# Public base URL of the backend (Cloudflare Tunnel or AWS), used in TwiML <Stream> and webhooks.
# Twilio signs requests against this URL, so it must match the webhook URL configured in Twilio.
PUBLIC_BASE_URL=https://example.trycloudflare.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Our own Twilio number in E.164 (+48...). Outbound calls and SMS to it are always refused.
TWILIO_NUMBER=
# Development only: accept Twilio webhooks without a signature when TWILIO_AUTH_TOKEN is empty.
ALLOW_UNSIGNED_WEBHOOKS=false

# Model endpoints (self-hosted). Native run on the Mac: 127.0.0.1; a backend in a Docker
# container uses http://host.docker.internal:8080 and :8000 instead.
WHISPER_URL=http://127.0.0.1:8080
DECISION_BACKEND=basal            # basal | clef | rules
BASAL_URL=http://127.0.0.1:8000
CLEF_URL=http://127.0.0.1:8001
# Slower decision-model answers fall back to the keyword rules.
DECISION_TIMEOUT_SECONDS=3.0
# basal's six questions are asked after the first warn-level reading and again at most every
# N seconds while the hang-up gate is blocked only by a stale secrecy answer (0 = once).
DECISION_FULL_REFRESH_SECONDS=10

# Hugging Face token (optional; PKOBP/embed-modernbert-68m is no longer gated)
HF_TOKEN=

# Speech-to-text: the caller's audio is cut at pauses into 3-8 s segments (energy VAD)
STT_MIN_SEGMENT_SECONDS=3.0
STT_MAX_SEGMENT_SECONDS=8.0
STT_PAUSE_SECONDS=0.2
STT_TIMEOUT_SECONDS=5.0
# Also transcribe the senior's microphone (app audio) as context for the risk model.
ANALYSE_SENIOR=true
STT_SENIOR_MIN_SEGMENT_SECONDS=1.5

# Risk thresholds (0-100). Warn: >= RISK_WARN two readings in a row. Family-password check
# and hang-up: the MODEL score >= RISK_HANGUP two readings in a row AND (model secrecy >=
# SECRECY_HANGUP_MIN or a keyword-rule hit). Rules alone (model down) can only warn.
RISK_WARN=50
RISK_HANGUP=90
SECRECY_HANGUP_MIN=0.8

# Language for voice prompts and speech recognition: pl | en
DEFAULT_LANG=pl

# Telephony cost and safety limits (safe defaults, see server/README.md)
# Outbound calls, SMS and REST hang-ups are only logged ("would do X") unless set to false.
TELEPHONY_DRY_RUN=true
# Comma-separated E.164 numbers outbound calls and SMS may go to; anything else is refused.
OUTBOUND_ALLOWLIST=
# Trusted person alerted on high risk (E.164, must also be on OUTBOUND_ALLOWLIST).
TRUSTED_PERSON_NUMBER=
# Fail-open route: the senior's own number (E.164, must be on OUTBOUND_ALLOWLIST). When no
# app is connected the caller is connected straight to it (Twilio <Dial>); not in dry-run.
SENIOR_NUMBER=
MAX_OUTBOUND_CALLS_PER_DAY=10
MAX_SMS_PER_DAY=20
# Extra incoming calls hear "protection temporarily unavailable" and are hung up.
MAX_CONCURRENT_CALLS=2
# The media stream ends itself after this many seconds; Twilio then hangs up the call.
MAX_CALL_SECONDS=600
# More incoming-call webhooks per minute get HTTP 429.
MAX_INCOMING_CALLS_PER_MINUTE=10
# Daily outbound counters (date and counts only) and generated voice prompts (prompts/).
DATA_DIR=data

# Senior app relay (protocol v0, docs/APP_PROTOCOL.md)
# Device secret for WS /app/control, at least 16 characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the app cannot connect and every call hears "protection unavailable".
APP_DEVICE_TOKEN=
# Ringing time before an unanswered protected call is ended.
APP_ACCEPT_TIMEOUT_SECONDS=30
# Family password (3-12 digits) asked for on high risk, typed as DTMF by the caller or the
# senior. Empty = no password prompt: the app shows a countdown (`confirm_block`) and the
# call is blocked after AUTO_BLOCK_SECONDS.
FAMILY_PASSWORD=
# Seconds from the password request to the block when no correct password arrives.
PASSWORD_TIMEOUT_SECONDS=12
AUTO_BLOCK_SECONDS=8

# Browser test pages /dev/caller and /dev/senior. Never enable in production.
DEV_TOOLS=false

LOG_LEVEL=INFO

# Docker deployment (deploy/docker-compose.yml): public host name for Caddy's automatic
# HTTPS, and model URLs as seen from the backend container.
DOMAIN=
DOCKER_WHISPER_URL=http://host.docker.internal:8080
DOCKER_BASAL_URL=http://host.docker.internal:8000
