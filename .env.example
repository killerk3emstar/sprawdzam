# Copy to .env and fill in. Never commit .env.

# Public base URL of the backend (Cloudflare Tunnel or AWS), used in TwiML <Stream> and webhooks.
# Twilio signs requests against this URL, so it must match the webhook URL configured in Twilio.
PUBLIC_BASE_URL=https://example.trycloudflare.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Our own Twilio number in E.164 (+48...). Outbound calls and SMS to it are always refused.
TWILIO_NUMBER=
# Development only: accept Twilio webhooks without a signature when TWILIO_AUTH_TOKEN is empty.
ALLOW_UNSIGNED_WEBHOOKS=false

# Model endpoints (self-hosted)
WHISPER_URL=http://host.docker.internal:8080
DECISION_BACKEND=basal            # basal | clef | rules
BASAL_URL=http://host.docker.internal:8000
CLEF_URL=http://host.docker.internal:8001
# Slower decision-model answers fall back to the keyword rules.
DECISION_TIMEOUT_SECONDS=2.0

# Hugging Face token (optional; PKOBP/embed-modernbert-68m is no longer gated)
HF_TOKEN=

# Audio pipeline: window sent to speech-to-text (1-10 s) and its timeout
STT_WINDOW_SECONDS=3.0
STT_TIMEOUT_SECONDS=8.0

# Risk thresholds (0-100)
RISK_WARN=50
RISK_HANGUP=80

# Language for voice prompts and speech recognition: pl | en
DEFAULT_LANG=pl

# Telephony cost and safety limits (safe defaults, see server/README.md)
# Outbound calls, SMS and REST hang-ups are only logged ("would do X") unless set to false.
TELEPHONY_DRY_RUN=true
# Comma-separated E.164 numbers outbound calls and SMS may go to; anything else is refused.
OUTBOUND_ALLOWLIST=
# Trusted person alerted on high risk (E.164, must also be on OUTBOUND_ALLOWLIST).
TRUSTED_PERSON_NUMBER=
MAX_OUTBOUND_CALLS_PER_DAY=10
MAX_SMS_PER_DAY=20
# Extra incoming calls hear "protection temporarily unavailable" and are hung up.
MAX_CONCURRENT_CALLS=2
# The media stream ends itself after this many seconds; Twilio then hangs up the call.
MAX_CALL_SECONDS=600
# More incoming-call webhooks per minute get HTTP 429.
MAX_INCOMING_CALLS_PER_MINUTE=10
# Where the daily outbound counters are stored (date and counts only, no numbers or content).
DATA_DIR=data

# Senior app relay (protocol v0, docs/APP_PROTOCOL.md)
# Device secret for WS /app/control, at least 16 characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the app cannot connect and every call hears "protection unavailable".
APP_DEVICE_TOKEN=
# Ringing time before an unanswered protected call is ended.
APP_ACCEPT_TIMEOUT_SECONDS=30
# Family password (3-12 digits) asked for on high risk, typed as DTMF by the caller or the
# senior. Empty = high-risk calls are blocked right after the prompt.
FAMILY_PASSWORD=
VERIFY_PASSWORD_SECONDS=20

# Browser test pages /dev/caller and /dev/senior. Never enable in production.
DEV_TOOLS=false

LOG_LEVEL=INFO
