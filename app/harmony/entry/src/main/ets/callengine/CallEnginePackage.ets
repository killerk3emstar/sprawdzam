/**
 * Registers the CallEngine TurboModule with RNOH (see PackageProvider.ets).
 * The C++ side (ArkTSTurboModule glue) is generated by codegen-harmony into cpp/generated/.
 */
import { RNOHPackage, UITurboModule, UITurboModuleFactory } from '@rnoh/react-native-openharmony';
import { UITurboModuleContext } from '@rnoh/react-native-openharmony/src/main/ets/RNOH/RNOHContext';
import { CallEngineTurboModule } from './CallEngineTurboModule';

class CallEngineTurboModulesFactory extends UITurboModuleFactory {
  createTurboModule(name: string): UITurboModule | null {
    if (name === CallEngineTurboModule.NAME) {
      return new CallEngineTurboModule(this.ctx);
    }
    return null;
  }

  hasTurboModule(name: string): boolean {
    return name === CallEngineTurboModule.NAME;
  }
}

export class CallEnginePackage extends RNOHPackage {
  override createUITurboModuleFactory(ctx: UITurboModuleContext): UITurboModuleFactory {
    return new CallEngineTurboModulesFactory(ctx);
  }

  override getDebugName(): string {
    return 'CallEnginePackage';
  }
}
