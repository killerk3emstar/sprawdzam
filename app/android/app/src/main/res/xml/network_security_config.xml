<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds allow cleartext ws:// only to the local backend reached through `adb reverse`;
     everything else (e.g. a Cloudflare tunnel) must use wss://. Debug builds allow all cleartext
     (src/debug/AndroidManifest.xml) for Metro. -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
